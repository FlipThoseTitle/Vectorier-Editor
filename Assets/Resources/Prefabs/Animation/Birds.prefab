  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a14227d102725bc46979f3da84284125, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  contentXml: "<Init>\n  <SetVariable Name=\"$Active\" Value=\"1\" />\n  <SetVariable
    Name=\"$AI\" Value=\"-1\" />\n  <SetVariable Name=\"$Node\" Value=\"COM\" />\n 
    <SetVariable Name=\"First_Sound\" Value=\"birds1\" />\n  <SetVariable Name=\"Second_Sound\"
    Value=\"birds2\" />\n  <SetVariable Name=\"Third_Sound\" Value=\"birds3\" />\n 
    <SetVariable Name=\"Flag1\" Value=\"0\" />\n</Init>\n<Loop>\n  <Events>\n   
    <EventBlock Template=\"NoneType.Only\" />\n  </Events>\n  <Conditions />\n  <Actions>\n   
    <ActionBlock Template=\"NoneType.Only\" />\n    <Choose Order=\"Random\" Set=\"1\">\n     
